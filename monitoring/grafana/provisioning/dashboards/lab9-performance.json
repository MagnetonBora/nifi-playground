  {
   "id": 6,
   "type": "timeseries",
   "title": "FlowFiles queued in front of each processor",
   "description": "A queue that stays long in front of a processor marks the bottleneck",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "nifi_amount_items_queued{component_type=\"Connection\"} * on(parent_id) group_left() label_replace(0 * nifi_amount_items_queued{component_type=\"ProcessGroup\", component_name=\"Lab 9 - Performance test\"} + 1, \"parent_id\", \"$1\", \"component_id\", \"(.*)\")",
     "legendFormat": "{{destination_name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Active threads per processor",
   "description": "Threads running at the scrape moment; the bottleneck is busy all the time",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "nifi_amount_threads_active{component_type=\"Processor\"} * on(parent_id) group_left() label_replace(0 * nifi_amount_items_queued{component_type=\"ProcessGroup\", component_name=\"Lab 9 - Performance test\"} + 1, \"parent_id\", \"$1\", \"component_id\", \"(.*)\")",
     "legendFormat": "{{component_name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
